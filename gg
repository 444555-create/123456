    <div class="rule">SELECT YOUR POSSIBILITY</div>
  </section>

  <main>
    <section class="stage" aria-label="平行人生販賣機操作區">
      <div class="machine-wrap">
        <span class="spark s1">✳</span><span class="spark s2">✦</span><span class="spark s3">✧</span>
        <div class="machine" id="machine">
          <div class="machine-top"><span>PARALLEL LIFE</span><span>NO. 0088</span></div>
          <div class="machine-window">
            <div class="window-label">CHOOSE • TURN • DISCOVER</div>
            <div class="shelf"></div>
            <div class="vending-items" aria-hidden="true">
              <div class="capsule">☾</div><div class="capsule">✿</div><div class="capsule">★</div>
            </div>
          </div>
          <div class="machine-controls">
            <div class="slot-area">YOUR POSSIBILITY<div class="slot"></div></div>
            <div class="lever-zone"><button class="lever" id="lever" type="button" aria-label="拉下販賣機拉桿">↻</button><span>PULL</span></div>
          </div>
          <div class="machine-foot"></div>
        </div>
      </div>

      <div class="panel">
        <div class="step-tag" id="stepTag">STEP 01 / 選擇方向</div>
        <h2 id="panelTitle">如果人生可以重選，<br>你想走向哪裡？</h2>
        <p class="panel-copy" id="panelCopy">選一個此刻最讓你心動的方向。販賣機會替你抽出一張來自平行宇宙的命運票券。</p>
        <div class="choices" id="choices">
          <button class="choice" data-choice="冒險" type="button"><span class="emoji">🧭</span><strong>遠方冒險</strong><small>去沒去過的地方</small></button>
          <button class="choice" data-choice="創作" type="button"><span class="emoji">🎨</span><strong>自由創作</strong><small>把喜歡變成日常</small></button>
          <button class="choice" data-choice="愛與連結" type="button"><span class="emoji">♡</span><strong>愛與連結</strong><small>遇見重要的人</small></button>
          <button class="choice" data-choice="未知" type="button"><span class="emoji">☄</span><strong>未知可能</strong><small>交給宇宙安排</small></button>
        </div>
        <div class="action-row">
          <button class="primary" id="drawBtn" type="button" disabled>投入硬幣・抽取票券 ↗</button>
          <button class="secondary" id="resetBtn" type="button">重新開始</button>
        </div>
        <p class="hint" id="hint" role="status" aria-live="polite">先選擇一種人生方向，拉桿就會亮起來。</p>
      </div>
    </section>

    <section class="ticket-zone" id="ticketZone" aria-live="polite">
      <div class="ticket-heading"><div class="eyebrow">YOUR PARALLEL LIFE HAS ARRIVED</div></div>
      <article class="ticket" id="ticket">
        <div class="ticket-top"><span>✳ PARALLEL LIFE TICKET</span><span id="ticketNo">PL-0001</span></div>
        <div class="ticket-main">
          <div>
            <div class="ticket-kicker" id="ticketCategory">A LIFE OF ADVENTURE</div>
            <h3 id="ticketTitle">在海邊開一間深夜書店</h3>
            <p class="ticket-desc" id="ticketDesc"></p>
          </div>
          <div class="ticket-stamp">ANOTHER<br>YOU<br>✳</div>
        </div>
        <div class="ticket-bottom"><span>VALID IN ONE UNIVERSE ONLY</span><span id="ticketDate">ISSUED JUST NOW</span></div>
      </article>
      <div class="ticket-actions">
        <button class="primary" id="saveBtn" type="button">♡ 收藏這張票券</button>
        <button class="secondary" id="againBtn" type="button">再抽一張</button>
      </div>
    </section>

    <section class="saved-section">
      <div class="saved-head"><h2>收藏的平行人生 <span style="color:var(--pink)">✳</span></h2><p>把想像過的自己，好好收起來。</p></div>
      <div class="saved-list" id="savedList"><div class="empty" id="emptySaved">目前還沒有收藏。抽到喜歡的命運，就把它留下吧。</div></div>
    </section>
  </main>
  <footer class="footer"><span>PARALLEL LIFE VENDING MACHINE</span><span>MADE OF MAYBES & LITTLE DREAMS ✳</span></footer>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  "use strict";
  const $ = (id) => document.getElementById(id);
  const data = {
    "冒險":[
      ["把家搬到有海風的地方","你在一座靠海的小鎮醒來，白天替旅人帶路，傍晚沿著堤岸散步。你終於明白，生活不必一直趕路，也可以是一段很長的風景。"],
      ["成為凌晨出發的旅行寫作者","你的行李永遠半滿，筆記本永遠有空白。你用故事交換陌生城市的早餐，也在每次迷路時，找到一點新的自己。"],
      ["在山裡經營一間小旅店","窗外有雲霧、木頭香和慢慢煮開的茶。每個來訪的人都帶著故事，而你學會把安靜也當成一種豐盛。"],
      ["搭上沒有目的地的列車","你買了單程票，沿途在小站下車。沒有精準計畫的日子，反而讓你遇見最意想不到的風景。"]
    ],
    "創作":[
      ["開一間只賣自己作品的小店","店裡放著你做的陶器、畫和奇怪的小物。有人推門進來說很喜歡，你忽然覺得，那些曾經偷偷喜歡的事都值得被看見。"],
      ["成為替城市畫畫的人","你背著畫具穿梭街區，把轉角的早餐店、午後的窗和路人的笑容畫下來。城市因為你的眼睛，多了一本溫柔的日記。"],
      ["在森林旁寫一本書","你把日常裡沒說出口的感受寫成故事。某個讀者寄來一封信，說你的文字陪他度過一段夜晚。"],
      ["組一個小小的音樂團","你們在地下室練團，在不大的舞台上唱歌。每次演出都不完美，但每次都真實得發亮。"]
    ],
    "愛與連結":[
      ["和老朋友開一間晚餐食堂","每天傍晚，熟悉的人帶著新朋友來吃飯。餐桌總是太擠、笑聲總是太大，而你終於有了想回去的地方。"],
      ["在陌生城市遇見靈魂夥伴","你們從一場迷路開始，聊到天亮。這段關係沒有標準答案，只有願意聽懂彼此的耐心。"],
      ["成為社區裡的故事收集者","你開始拜訪鄰居，記下他們的回憶。慢慢地，一條街變成一個家，而你知道連結可以從一句你好開始。"],
      ["把更多時間留給自己與家人","你不再把行程塞滿，開始一起散步、煮飯和發呆。那些看似普通的片刻，成了最珍貴的收藏。"]
    ],
    "未知":[
      ["住進一座會移動的房子","你的家每個月換一個地方，有時靠近森林，有時停在城市邊緣。你不再急著定義歸屬，因為每個清晨都能重新開始。"],
      ["成為深夜電台的神秘主持人","午夜十二點，你用聲音陪伴陌生人。沒有人知道你的模樣，但有很多人記得你說過的那句晚安。"],
      ["在小島上開一間奇怪博物館","館裡收藏沒寄出的信、遺失的鈕扣和人們的小願望。每個物件都有故事，而你負責讓它們繼續發光。"],
      ["發明一種交換夢境的機器","你收集人們的夢，做成一場場小型展覽。現實與想像的邊界變得柔軟，連明天都充滿驚喜。"]
    ]
  };
  const categoryLabel = {"冒險":"A LIFE OF ADVENTURE","創作":"A LIFE OF CREATION","愛與連結":"A LIFE OF CONNECTION","未知":"A LIFE UNKNOWN"};
  let selected = "";
  let current = null;
  let soundOn = false;
  let audioContext = null;
  let saved = [];

  function tone(freq=440, duration=.12, type="sine", volume=.035){
    if(!soundOn) return;
    try{
      audioContext ||= new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioContext.createOscillator(), gain = audioContext.createGain();
      osc.type=type; osc.frequency.setValueAtTime(freq,audioContext.currentTime);
      gain.gain.setValueAtTime(volume,audioContext.currentTime);
      gain.gain.exponentialRampToValueAtTime(.001,audioContext.currentTime+duration);
      osc.connect(gain);gain.connect(audioContext.destination);osc.start();osc.stop(audioContext.currentTime+duration);
    }catch(e){ /* 音效不可用時不影響遊戲 */ }
  }
  function chime(){tone(523,.12);setTimeout(()=>tone(659,.13),110);setTimeout(()=>tone(784,.2),230)}
  function toast(message){
    $("toast").textContent=message;$("toast").classList.add("show");
    clearTimeout(toast.timer);toast.timer=setTimeout(()=>$("toast").classList.remove("show"),2100);
  }
  function choose(direction){
    selected=direction;
    document.querySelectorAll(".choice").forEach(btn=>btn.classList.toggle("selected",btn.dataset.choice===direction));
    $("drawBtn").disabled=false;
    $("hint").textContent=`已選擇「${direction}」——準備好讓另一個自己登場了嗎？`;
    $("stepTag").textContent="STEP 02 / 準備抽取";
    tone(440,.08);
  }
  function makeTicket(){
    const options=data[selected];
    const item=options[Math.floor(Math.random()*options.length)];
    const serial=String(Math.floor(1000+Math.random()*9000));
    const now=new Date();
    return {direction:selected,title:item[0],desc:item[1],serial,issued:now.toLocaleDateString("zh-TW",{year:"numeric",month:"2-digit",day:"2-digit"})};
  }
  function renderTicket(ticket){
    current=ticket;
    $("ticketNo").textContent="PL-"+ticket.serial;
    $("ticketCategory").textContent=categoryLabel[ticket.direction];
    $("ticketTitle").textContent=ticket.title;
    $("ticketDesc").textContent=ticket.desc;
    $("ticketDate").textContent="ISSUED "+ticket.issued;
    $("ticketZone").classList.remove("show");
    void $("ticketZone").offsetWidth;
    $("ticketZone").classList.add("show");
    $("saveBtn").textContent="♡ 收藏這張票券";
    $("saveBtn").disabled=false;
    $("ticketZone").scrollIntoView({behavior:"smooth",block:"center"});
  }
  function draw(){
    if(!selected){toast("先選擇一種人生方向！");return}
    $("drawBtn").disabled=true;$("lever").disabled=true;
    $("hint").textContent="販賣機正在運轉……平行宇宙連線中。";
    $("machine").classList.remove("shake");void $("machine").offsetWidth;$("machine").classList.add("shake");
    tone(180,.12,"square",.025);setTimeout(()=>tone(240,.14,"square",.025),150);setTimeout(()=>tone(320,.16,"triangle",.025),300);
    setTimeout(()=>{
      renderTicket(makeTicket());chime();
      $("hint").textContent="票券已送達！也許另一個你，正在過著這樣的生活。";
      $("stepTag").textContent="STEP 03 / 命運已送達";
      $("lever").disabled=false;$("drawBtn").disabled=false;
      toast("咔噠！你的平行人生已出貨。");
    },720);
  }
  function saveCurrent(){
    if(!current)return;
    if(saved.some(x=>x.serial===current.serial)){toast("這張票券已經收藏過囉！");return}
    saved.unshift({...current});
    $("saveBtn").textContent="✓ 已收藏";
    $("saveBtn").disabled=true;
    renderSaved();tone(660,.1);setTimeout(()=>tone(880,.18),100);toast("已放進你的平行人生收藏冊！");
  }
  function renderSaved(){
    const list=$("savedList");list.innerHTML="";
    if(!saved.length){const empty=document.createElement("div");empty.className="empty";empty.textContent="目前還沒有收藏。抽到喜歡的命運，就把它留下吧。";list.append(empty);return}
    saved.forEach(ticket=>{
      const item=document.createElement("article");item.className="saved-item";
      const meta=document.createElement("small");meta.textContent=`${ticket.direction} / PL-${ticket.serial}`;
      const title=document.createElement("strong");title.textContent=ticket.title;
      const desc=document.createElement("small");desc.textContent=ticket.desc;
      const remove=document.createElement("button");remove.type="button";remove.textContent="移除收藏";
      remove.addEventListener("click",()=>{saved=saved.filter(x=>x.serial!==ticket.serial);renderSaved();toast("已從收藏中移除。")});
      item.append(meta,title,desc,remove);list.append(item);
    });
  }
  function reset(){
    selected="";current=null;
    document.querySelectorAll(".choice").forEach(btn=>btn.classList.remove("selected"));
    $("drawBtn").disabled=true;$("lever").disabled=false;
    $("stepTag").textContent="STEP 01 / 選擇方向";
    $("panelTitle").innerHTML="如果人生可以重選，<br>你想走向哪裡？";
    $("panelCopy").textContent="選一個此刻最讓你心動的方向。販賣機會替你抽出一張來自平行宇宙的命運票券。";
    $("hint").textContent="先選擇一種人生方向，拉桿就會亮起來。";
    $("ticketZone").classList.remove("show");
    $("machine").classList.remove("shake");
    $("ticketZone").style.display=""; // 保留原本 display 規則
    toast("旅程重置了。這次想去哪個宇宙？");
    window.scrollTo({top:0,behavior:"smooth"});
  }
  document.querySelectorAll(".choice").forEach(btn=>btn.addEventListener("click",()=>choose(btn.dataset.choice)));
  $("drawBtn").addEventListener("click",draw);
  $("lever").addEventListener("click",draw);
  $("saveBtn").addEventListener("click",saveCurrent);
  $("againBtn").addEventListener("click",()=>{if(!selected){reset();return}draw()});
  $("resetBtn").addEventListener("click",reset);
  $("soundToggle").addEventListener("click",()=>{
    soundOn=!soundOn;
    $("soundToggle").setAttribute("aria-pressed",String(soundOn));
    $("soundToggle").textContent=soundOn?"♫ 音效：開":"♫ 音效：關";
    if(soundOn){tone(660,.1);toast("音效已開啟。")}else toast("音效已關閉。");
  });
})();
</script>
</body>
</html>
